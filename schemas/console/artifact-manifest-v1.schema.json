{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-native.local/schemas/console/artifact-manifest-v1.schema.json",
  "title": "AI-Native Artifact Manifest v1",
  "type": "object",
  "required": ["schema_version", "run_id", "artifacts"],
  "properties": {
    "schema_version": { "const": 1 },
    "run_id": { "type": "string" },
    "artifacts": { "type": "array", "items": { "type": "object", "required": ["artifact_id", "relative_path", "role"], "properties": { "artifact_id": { "type": "string" }, "relative_path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+" }, "role": { "type": "string" }, "kind": { "type": "string" }, "mime_type": { "type": "string" }, "size": { "type": "integer", "minimum": 0 }, "sha256": { "type": ["string", "null"] } }, "additionalProperties": true } }
  }
}

.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.inspect/
logs/
runs/
reports/*.json
reports/*.jsonl
!reports/.gitkeep
.env
.env.*
!.env.example
.env.local
config/.env.local

# Source package name is runs; do not confuse it with runtime output directories.
!src/ai_native_evals/runs/
!src/ai_native_evals/runs/**
src/ai_native_evals/runs/**/__pycache__/
src/ai_native_evals/runs/**/__pycache__/**
# Local dependency caches stay on disk for offline builds but are not committed.
# Keep only the small reproducibility metadata and lock files in Git.
cache/*
!cache/codex/
cache/codex/*
!cache/codex/VERSION
!cache/python/
!cache/python/*/
cache/python/*/wheels/*
!cache/python/*/wheels/
!cache/python/*/wheels/.gitkeep
!cache/python/*/requirements.lock
!cache/manifest.json

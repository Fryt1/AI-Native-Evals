.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.inspect/
logs/
runs/
reports/*.json
reports/*.jsonl
!reports/.gitkeep
.env
.env.*
!.env.example
.env.local
config/.env.local

# Source package name is runs; do not confuse it with runtime output directories.
!src/ai_native_evals/runs/
!src/ai_native_evals/runs/**
!src/ai_native_evals/runs/__pycache__/
!src/ai_native_evals/runs/__pycache__/**
# Local dependency caches are never committed. They are admitted to the Docker
# build context only when explicitly named below.
cache/
!cache/codex/
!cache/codex/openai-codex.tgz
!cache/codex/codex-linux-x64.tgz
!cache/codex/VERSION
